# Django Settings
DJANGO_SECRET_KEY=django-insecure-dev-key-change-in-production-6477
DEBUG=1
ALLOWED_HOSTS=*
CORS_ALLOW_ALL_ORIGINS=True

# Ingress Port (bound to 127.0.0.1)
INGRESS_PORT=6477

# Authelia Secrets
AUTHELIA_JWT_SECRET=a_very_long_secret_key_for_authelia_jwt_testing_32chars
AUTHELIA_SESSION_SECRET=unsecure_session_secret_for_dev_only_32_chars_long

# Davai API Key for OpenCode MCP
DAVAI_API_KEY=dav_live_your_api_key_here

# PostgreSQL 18 Database Settings
POSTGRES_DB=davai
POSTGRES_USER=davai
POSTGRES_PASSWORD=davai_dev_secret_password_6477

# Django Settings
DJANGO_SECRET_KEY=django-insecure-dev-key-change-in-production-6477
DEBUG=1
ALLOWED_HOSTS=*
CORS_ALLOW_ALL_ORIGINS=True

# Ingress Port (bound to 127.0.0.1)
INGRESS_PORT=6477

# Authelia Secrets
AUTHELIA_JWT_SECRET=a_very_long_secret_key_for_authelia_jwt_testing_32chars
AUTHELIA_SESSION_SECRET=unsecure_session_secret_for_dev_only_32_chars_long

# Davai API Key for OpenCode MCP
DAVAI_API_KEY=dav_live_your_api_key_here

# PostgreSQL 18 Database Settings
POSTGRES_DB=davai
POSTGRES_USER=davai
POSTGRES_PASSWORD=davai_dev_secret_password_6477
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# Cloudflare Tunnel
CLOUDFLARED_TOKEN=your_cloudflared_tunnel_token_here

# Local plain-HTTP OIDC overrides (uncomment for http://127.0.0.1:6477 without
# the Cloudflare tunnel). Leave these unset when the stack is reached over HTTPS
# (tunnel / ingress): the backend then derives every endpoint from OIDC_ISSUER_URL.
# OIDC_ISSUER_URL=http://authelia:9091/authelia
# OIDC_AUTHORIZATION_URL=http://127.0.0.1:6477/authelia/api/oidc/authorization
# OIDC_TOKEN_URL=http://nginx/authelia-internal/api/oidc/token
# OIDC_USERINFO_URL=http://nginx/authelia-internal/api/oidc/userinfo
# OIDC_JWKS_URL=http://nginx/authelia-internal/jwks.json
# OIDC_FORWARDED_HOST=127.0.0.1
# OIDC_REDIRECT_URI=http://127.0.0.1:6477/api/auth/oidc/callback

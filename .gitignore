# Git ignore for Davai

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
.env
venv/
ENV/

# Django & SQLite
backend/data/
*.sqlite3
*.sqlite3-journal

# Node & Frontend
frontend/node_modules/
frontend/dist/
frontend/.vite/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
*.tsbuildinfo

# Authelia
authelia/config/db.sqlite3*
authelia/config/notification.txt

# OS & Editors
.DS_Store
Thumbs.db
.idea/
.vscode/

# OpenCode
opencode/share/*
!opencode/share/.gitkeep
opencode/data/*
!opencode/data/.gitkeep
